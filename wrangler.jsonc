{
  // Cloudflare Workers: dist klasöründeki siteyi yayınlar, /api/ isteklerini worker/index.js karşılar.
  "name": "tahta-atolyesi",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Gizli olmayan ayarlar. Gemini anahtarı burada DEĞİL, Cloudflare panelinde Secret olarak durur.
  "vars": {
    "GOOGLE_CLIENT_ID": "559335998298-1717utra0fliq2qnqobugtagar9okr5o.apps.googleusercontent.com",
    "DAILY_LIMIT": "10",
    "GLOBAL_LIMIT": "400",
    "GEMINI_MODEL": "gemini-2.5-flash-lite"
  },
  "durable_objects": {
    "bindings": [{ "name": "KOTA", "class_name": "Kota" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Kota"] }]
}
